{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "ignorePatterns": ["**/coverage/**", "**/build/**", "**/dist/**"],
  "rules": {
    "typescript/no-explicit-any": "off",
    "typescript/no-extraneous-class": "allow",
    "curly": "off",
    "no-shadow": "off",
    "no-unused-vars": "error",
    "no-console": "allow",
    "no-underscore-dangle": "allow",
    "no-floating-promises": "allow"
  },
  "overrides": [
    {
      "files": [
        "src/renderer/**/*.tsx",
        "src/ui/**/*.tsx",
        "src/music/**/*.tsx"
      ],
      "plugins": ["typescript", "react"],
      "rules": {
        "react/react-in-jsx-scope": "off",
        "react/jsx-no-literals": [
          "error",
          {
            "restrictedAttributes": [
              "title",
              "label",
              "aria-label",
              "description",
              "placeholder",
              "confirmText",
              "hint",
              "empty",
              "alt",
              "feature"
            ],
            "allowedStrings": [
              "",
              "Tokio",
              "Tok",
              "io",
              "v",
              "TikTok LIVE",
              "Minecraft",
              "Archivo",
              "×",
              "(×)",
              "🌹"
            ]
          }
        ]
      }
    },
    {
      "files": ["**/*.test.tsx"],
      "plugins": ["typescript", "react"],
      "rules": { "react/jsx-no-literals": "off" }
    }
  ]
}

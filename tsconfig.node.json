{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": ["electron.vite.config.*", "src/main/**/*", "src/preload/**/*","src/common/**/*", "scripts/**/*", "test/**/*", "e2e/**/*", "vitest.config.ts", "playwright.config.ts"],
  // Renderer test helpers need the DOM, tsconfig.web.json checks them
  "exclude": ["test/renderer/**"],
  "compilerOptions": {
    "composite": true,
    "strictPropertyInitialization": false,
    "paths": {
      "@/*":["./src/main/*"],
      "@/common/*":["./src/common/*"],
      "@test/*":["./test/main/*"]
    },
    "types": ["electron-vite/node"]
  }
}

{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "src/renderer/src/env.d.ts",
    "src/renderer/src/**/*",
    "src/renderer/src/**/*.tsx",
    "src/music/**/*",
    "src/common/**/*",
    "src/ui/**/*",
    "test/renderer/**/*",
  ],
  "compilerOptions": {
    "composite": true,
    "jsx": "react-jsx",
    "paths": {
      "@renderer/*": [
        "./src/renderer/src/*"
      ],
      "@/*":["./src/renderer/src/*"],
      "@/common/*":["./src/common/*"],
      "@/ui/*":["./src/ui/*"],
      "@test/*":["./test/renderer/*"]
    }
  }
}

{
  "name": "tokio",
  "version": "0.1.0-alpha.6",
  "description": "Make your TikTok LIVE react to chat, gifts, likes and more",
  "main": "./out/main/index.js",
  "type": "module",
  "author": "Akuqt",
  "license": "MIT",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tokio-app/tokio.git"
  },
  "keywords": [
    "tiktok",
    "live",
    "tts",
    "integration",
    "overlays",
    "animations"
  ],
  "bugs": {
    "url": "https://github.com/tokio-app/tokio/issues"
  },
  "homepage": "https://tokio.ialfaro.com",
  "scripts": {
    "format": "prettier --write .",
    "lint": "oxlint --type-aware",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "yarn typecheck:node && yarn typecheck:web",
    "start": "electron-vite preview",
    "build:music:ui": "vite build --config src/music/vite.config.ts",
    "dev": "yarn build:music:ui && electron-vite dev",
    "build": "yarn typecheck && yarn build:music:ui && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "yarn build && electron-builder --dir",
    "build:win": "yarn build && electron-builder --win",
    "build:mac": "yarn build && electron-builder --mac",
    "build:linux": "yarn build && electron-builder --linux",
    "clean": "node ./scripts/clean/index.js",
    "todos": "node ./scripts/todos/index.js",
    "release:notes": "node ./scripts/release-notes/index.js",
    "tts:edge:check": "tsx ./scripts/edge-tts/index.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@tanstack/react-router": "^1.170.23",
    "@tanstack/react-virtual": "^3.14.12",
    "@vscode/sudo-prompt": "^9.3.2",
    "axios": "^1.18.1",
    "cheerio": "^1.2.0",
    "copy-to-clipboard": "^4.0.2",
    "electron-updater": "^6.3.9",
    "es-toolkit": "^1.51.0",
    "express": "^5.2.1",
    "fast-deep-equal": "^3.1.3",
    "fflate": "^0.8.3",
    "immer": "^11.1.16",
    "marked": "^18.1.1",
    "react": "^19.2.1",
    "react-colorful": "^5.8.1",
    "react-dom": "^19.2.1",
    "react-icons": "^5.7.0",
    "react-spinners": "^0.17.0",
    "tiktok-live-connector": "^2.4.3",
    "tone": "^15.1.22",
    "ws": "^8.21.1",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/express": "^5.0.6",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "fallow": "^3.16.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.1.0",
    "oxlint": "^1.74.0",
    "oxlint-tsgolint": "^0.25.0",
    "prettier": "^3.7.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vitest": "^5.0.3"
  }
}
